# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
env/
venv/

# uv lockfile — diskutabilní; pro aplikaci se obvykle COMMITUJE,
# pro library NE. ChessLab je app, takže lockfile by se commitovat MĚL.
# Pokud bys ho commitovat nechtěl, odkomentuj řádek níže:
# uv.lock

# IDE / editor / agent
.idea/
.vscode/
# Ignorujeme obsah .claude/, ALE re-include settings.json (= shared project-level
# permission allowlist). Per-user override settings.local.json zůstane ignored.
# Git pravidlo: musí být `.claude/*` (= soubory uvnitř), ne `.claude/` (= adresář),
# jinak negace neúčinkuje (parent dir excluded → git skip listing).
.claude/*
!.claude/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db

# Env a secrets
.env
.env.local
*.secret

# Logs
*.log
logs/

# Lokální databáze
*.sqlite
*.sqlite3
*.db

# Generované PGN / SVG / HTML výstupy z experimentů
output/
exports/
